# Copy to .env and adjust. Every setting can also be set as an environment variable.

# ---- identity
KV_NODE_ROLE=shard                  # shard | router
# KV_NODE_ID=shard-1                # default: <role>-<tcp_port>

# ---- networking
KV_HOST=127.0.0.1                   # use 0.0.0.0 inside containers
KV_HTTP_PORT=8000                   # FastAPI control plane
KV_TCP_PORT=6379                    # data plane
KV_TCP_ENABLED=true
KV_MAX_REQUEST_BYTES=67108864      # largest accepted bulk string

# ---- storage engine (shard)
KV_MAX_KEYS=0                       # 0 = unlimited
KV_MAXMEMORY_BYTES=0                # 0 = unlimited
KV_EVICTION_POLICY=lru              # lru | lfu | random | noeviction
KV_CRON_INTERVAL_S=0.1              # housekeeping tick (expiry, rewrites)
KV_ACTIVE_EXPIRY_SAMPLE_SIZE=20

# ---- persistence (shard)
# KV_DATA_DIR=./data/shard-6379     # default: ./data/<node_id>
KV_AOF_ENABLED=true
KV_AOF_FSYNC=everysec               # always | everysec | no
KV_AOF_REWRITE_PERCENTAGE=100       # auto-rewrite when the AOF doubles; 0 = off
KV_AOF_REWRITE_MIN_BYTES=67108864
KV_INCREMENTAL_SNAPSHOTS=true       # copy the keyspace in slices between commands (no long pause)
KV_SNAPSHOT_SLICE_MS=2.0            # time budget of one slice
KV_SNAPSHOT_SLICE_KEYS=256          # keys copied per chunk within a slice

# ---- replication (shard)
# KV_REPLICAOF=127.0.0.1:6379       # start as a replica of this primary
KV_REPL_BACKLOG_BYTES=1048576       # partial resync window
KV_REPL_TIMEOUT_S=5.0
KV_MIN_REPLICAS_TO_WRITE=0          # refuse writes with fewer fresh replicas (fences a cut-off primary)
KV_MIN_REPLICAS_MAX_LAG_S=10.0

# ---- cluster (router)
# Shard groups: 'host:port' (primary only) or 'id=primary+replica+...'
KV_SHARDS=127.0.0.1:6379,127.0.0.1:6380,127.0.0.1:6381
# KV_SHARDS=shard-1=127.0.0.1:6379+127.0.0.1:6479,shard-2=127.0.0.1:6380+127.0.0.1:6480
KV_VIRTUAL_NODES=100
KV_SHARD_TIMEOUT_S=2.0
KV_SHARD_POOL_SIZE=2                # multiplexed connections per node
KV_SHARD_RETRIES=3                  # only for requests that are safe to repeat
KV_WAIT_REPLICAS=0                  # 1 = ack a write only once a replica has it
KV_FAILOVER_ENABLED=true            # the cluster manager: heartbeats + failover
KV_HEARTBEAT_INTERVAL_S=0.5
KV_SUSPECT_AFTER_S=1.0
KV_DEAD_AFTER_S=2.0                 # silence before a primary is failed over

# ---- observability
KV_METRICS_ENABLED=true             # per-command counters and latency histograms on GET /metrics
KV_LOG_LEVEL=INFO
KV_LOG_FORMAT=json                  # json | text
KV_ACCESS_LOG=true
