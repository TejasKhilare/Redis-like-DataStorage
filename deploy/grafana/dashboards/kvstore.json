            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kvstore_router_commands_total[$__rate_interval]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
